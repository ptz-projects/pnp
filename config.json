{
  "defaults": {
    "role": "Access Switch",
    "dayn_template": "DayN-Template",
    "template_project": "Onboarding Configuration",
    "system_mtu": "1500",
    "native_vlan": "1"
  },
  "modes": {
    "STAGING_CONFIG": {
      "day0_template": "TM-PNP-SW-STAGING-IN-A-LAB",
      "params": {
        "Hostname": "{hostname}",
        "SystemMTU": "{system_mtu}"
      }
    },
    "FACTORY_CONFIG": {
      "day0_template": "TM-PNP-SW-FACTORY-INSTALL-AT-SITE",
      "params": {
        "Hostname": "{hostname}",
        "SystemMTU": "{system_mtu}",
        "MgmtVlan": "{mgmt_vlan}",
        "UplinkInterface": "{uplink_interface}",
        "AllowedVlans": "{allowed_vlans}",
        "NativeVlan": "{native_vlan}",
        "SwitchIP": "{mgmt_ip}",
        "SubnetMask": "{subnet_mask}",
        "Gateway": "{gateway}"
      }
    }
  },
  "sites": {
    "Brisbane CBD Office": { "catc_path": "Global/APAC/Australia/Brisbane/Brisbane CBD Office", "netbox_site": "Brisbane CBD Office" },
    "Perth CBD Office": { "catc_path": "Global/APAC/Australia/Perth/Perth CBD Office", "netbox_site": "Perth CBD Office" }
  },
  "images": {
    "C9300-48P": ""
  }
}
